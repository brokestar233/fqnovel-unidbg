# ============================================================
# fqnovel-unidbg 环境变量配置
# 复制此文件为 .env 并修改配置：cp .env.example .env
# 或运行 ./setup-env.sh 自动生成随机密码
# ============================================================

# Redis 密码（首次使用请修改或运行 setup-env.sh 自动生成）
REDIS_PASSWORD=change_me_to_a_random_password

# 服务端口
SERVER_PORT=8099

# 番茄小说 Cookie（可选，有默认值）
# FQ_API_COOKIE=store-region=cn-zj; store-region-src=did; install_id=2420480337007787;

# JVM 参数
# JAVA_OPTS=-Xms512m -Xmx1g

# ============================================================
# 代理配置（可选）
# ============================================================

# SOCKS5 代理地址和端口
# PROXY_HOST=192.168.50.3
# PROXY_PORT=10086

# ============================================================
# DNS 配置（可选，默认使用 DoH）
# ============================================================

# DoH (DNS over HTTPS) 服务器地址
# 默认使用 1.12.12.12（国内公共 DoH 服务）
# DOH_SERVER=https://1.12.12.12/dns-query

# ============================================================
# HTTPS / TLS 配置（可选，默认关闭）
# ============================================================

# 是否启用 HTTPS（设为 true 启用）
SSL_ENABLED=true

# TLS 证书文件路径（PEM 格式）
# 宿主机路径会被挂载到容器内对应路径
SSL_CERTIFICATE=/etc/brokestar.crt

# TLS 私钥文件路径（PEM 格式）
SSL_KEY=/etc/brokestar.key
