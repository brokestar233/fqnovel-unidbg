# ============================================================
# fqnovel-unidbg 环境变量配置
# 复制此文件为 .env 并修改配置：cp .env.example .env
# 或运行 ./setup-env.sh 自动生成随机密码
# ============================================================

# Redis 密码（首次使用请修改或运行 setup-env.sh 自动生成）
REDIS_PASSWORD=change_me_to_a_random_password

# 服务端口
SERVER_PORT=8099

# 番茄小说 Cookie（可选，有默认值）
# FQ_API_COOKIE=store-region=cn-zj; store-region-src=did; install_id=2420480337007787;

# JVM 参数
# JAVA_OPTS=-Xms512m -Xmx1g
